// 18 October 2026: Exact color math for sRGB, Linear sRGB (Houdini/Unreal), HSL, OKLCH, and WCAG 2.1 contrast.
struct ColorMath {
    let r: Double
    let g: Double
    let b: Double

    init(nsColor: NSColor) {
        let converted = nsColor.usingColorSpace(.sRGB) ?? nsColor
        self.r = max(0.0, min(1.0, Double(converted.redComponent)))
        self.g = max(0.0, min(1.0, Double(converted.greenComponent)))
        self.b = max(0.0, min(1.0, Double(converted.blueComponent)))
    }

    init?(hex: String) {
        var cleaned = hex.trimmingCharacters(in: .whitespacesAndNewlines)
        if cleaned.hasPrefix("#") { cleaned.removeFirst() }
        if cleaned.count == 3 {
            cleaned = cleaned.map { "\($0)\($0)" }.joined()
        }
        guard cleaned.count == 6, let val = UInt32(cleaned, radix: 16) else { return nil }
        self.r = Double((val >> 16) & 0xFF) / 255.0
        self.g = Double((val >> 8) & 0xFF) / 255.0
        self.b = Double(val & 0xFF) / 255.0
    }

    var nsColor: NSColor {
        NSColor(srgbRed: CGFloat(r), green: CGFloat(g), blue: CGFloat(b), alpha: 1.0)
    }

    var r255: Int { Int(round(r * 255.0)) }
    var g255: Int { Int(round(g * 255.0)) }
    var b255: Int { Int(round(b * 255.0)) }

    func hexString(lowercase: Bool) -> String {
        let raw = String(format: "#%02X%02X%02X", r255, g255, b255)
        return lowercase ? raw.lowercased() : raw
    }

    var rgbString: String { "rgb(\(r255), \(g255), \(b255))" }

    static func toLinear(_ c: Double) -> Double {
        return c <= 0.04045 ? (c / 12.92) : pow((c + 0.055) / 1.055, 2.4)
    }

    var linearRGB: (Double, Double, Double) {
        (Self.toLinear(r), Self.toLinear(g), Self.toLinear(b))
    }

    func linearString(precision: Int) -> String {
        let p = max(2, min(4, precision))
        let (lr, lg, lb) = linearRGB
        let fmt = "%.\(p)f"
        return String(format: "\(fmt), \(fmt), \(fmt)", lr, lg, lb)
    }

    var oklch: (L: Double, C: Double, H: Double) {
        let (lr, lg, lb) = linearRGB
        let l = 0.4122214708 * lr + 0.5363325363 * lg + 0.0514459929 * lb
        let m = 0.2119034982 * lr + 0.6806995451 * lg + 0.1073969566 * lb
        let s = 0.0883024619 * lr + 0.2817188376 * lg + 0.6299787005 * lb
        let l_ = cbrt(l), m_ = cbrt(m), s_ = cbrt(s)
        let L = 0.2104542553 * l_ + 0.7936177850 * m_ - 0.0040720468 * s_
        let a = 1.9779984951 * l_ - 2.4285922050 * m_ + 0.4505937099 * s_
        let bVal = 0.0259040371 * l_ + 0.7827717662 * m_ - 0.8086757660 * s_
        let C = sqrt(a * a + bVal * bVal)
        var H = atan2(bVal, a) * 180.0 / .pi
        if H < 0 { H += 360.0 }
        return (max(0.0, min(1.0, L)), max(0.0, C), C < 0.0001 ? 0.0 : H)
    }

    func oklchString(precision: Int) -> String {
        let p = max(2, min(4, precision))
        let (L, C, H) = oklch
        let fmt = "%.\(p)f"
        return String(format: "oklch(\(fmt) \(fmt) %.0f°)", L, C, H)
    }

    var relativeLuminance: Double {
        let (lr, lg, lb) = linearRGB
        return 0.2126 * lr + 0.7152 * lg + 0.0722 * lb
    }

    func contrastRatio(with other: ColorMath) -> Double {
        let l1 = max(self.relativeLuminance, other.relativeLuminance)
        let l2 = min(self.relativeLuminance, other.relativeLuminance)
        return (l1 + 0.05) / (l2 + 0.05)
    }
}

// 18 October 2026: Single-surface dark HUD root view (1 fond par région, zéro boîte imbriquée).
final class HUDRootView: NSView {
    var cornerRadius: CGFloat = 14 { didSet { needsDisplay = true } }
    override func draw(_ dirtyRect: NSRect) {
        let rect = bounds.insetBy(dx: 0.5, dy: 0.5)
        let path = NSBezierPath(roundedRect: rect, xRadius: cornerRadius, yRadius: cornerRadius)
        NSColor(srgbRed: 0.094, green: 0.094, blue: 0.102, alpha: 0.96).setFill()
        path.fill()
        NSColor(calibratedWhite: 1.0, alpha: 0.09).setStroke()
        path.lineWidth = 1.0
        path.stroke()
    }
}

// 18 October 2026: Diagonal split FG/BG swatch (24x24 pt, radius 7 pt) from Design C.
final class SplitSwatchView: NSView {
    var fgColor: NSColor = .systemPink { didSet { needsDisplay = true } }
    var bgColor: NSColor = .darkGray { didSet { needsDisplay = true } }
    var onLeftClick: (() -> Void)?
    var onRightClick: (() -> Void)?

    override func draw(_ dirtyRect: NSRect) {
        NSGraphicsContext.current?.saveGraphicsState()
        let clipPath = NSBezierPath(roundedRect: bounds, xRadius: 7, yRadius: 7)
        clipPath.addClip()

        bgColor.setFill()
        bounds.fill()

        let fgPath = NSBezierPath()
        fgPath.move(to: NSPoint(x: 0, y: bounds.height))
        fgPath.line(to: NSPoint(x: bounds.width, y: bounds.height))
        fgPath.line(to: NSPoint(x: bounds.width * 0.22, y: 0))
        fgPath.line(to: NSPoint(x: 0, y: 0))
        fgPath.close()
        fgColor.setFill()
        fgPath.fill()

        NSGraphicsContext.current?.restoreGraphicsState()
    }

    override func mouseDown(with event: NSEvent) {
        if event.modifierFlags.contains(.option) || event.modifierFlags.contains(.control) {
            onRightClick?()
        } else {
            onLeftClick?()
        }
    }

    override func rightMouseDown(with event: NSEvent) { onRightClick?() }
}

