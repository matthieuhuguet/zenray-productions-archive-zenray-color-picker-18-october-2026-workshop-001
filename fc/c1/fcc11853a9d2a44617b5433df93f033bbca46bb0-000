// 18 October 2026: HDA parametric configuration for ZenRayColorPicker (max 8 interactive parameters exposed in UI).
struct HDASettings: Codable, Equatable {
    var defaultFormat: String      // 1. HEX, RGB, HSL, OKLCH, LINEAR (18 October 2026)
    var autoCopyOnPick: Bool       // 2. Copy automatically after eyedropper pick (18 October 2026)
    var lowercaseHex: Bool         // 3. Format hex in lowercase (#b62721 vs #B62721) (18 October 2026)
    var floatPrecision: Int        // 4. Decimal places for Linear 3D & OKLCH (2, 3, 4) (18 October 2026)
    var historyLimit: Int          // 5. Number of history swatches kept (10 to 40) (18 October 2026)
    var windowWidth: Double        // 6. Panel width in points (320 to 460) (18 October 2026)
    var fontSize: Double           // 7. Base UI scale --zr-ui-base in points (11 to 16) (18 October 2026)
    var pickOnMenuClick: Bool      // 8. Left-click menu bar triggers eyedropper immediately (18 October 2026)
    var alwaysOnTop: Bool
    var fontSans: String
    var fontSerif: String
    var fontMono: String
    var initialForegroundHex: String
    var initialBackgroundHex: String
}

// 18 October 2026: Persistent state storing foreground, background, and picked color history.
struct AppState: Codable {
    var foregroundHex: String
    var backgroundHex: String
    var history: [String]
}

// 18 October 2026: Verification payload written when launched with --verify-proof.
struct ProofPayload: Codable {
    let checkedAt: String
    let bundleId: String
    let windowWidth: Double
    let windowHeight: Double
    let fontsLoaded: [String: Bool]
    let resolvedFonts: [String: String]
    let foregroundHex: String
    let backgroundHex: String
    let formats: [String: String]
    let contrastRatio: Double
    let wcagLevel: String
    let historyCount: Int
    let hdaParameterCount: Int
    let settingsPath: String
}

// 18 October 2026: Exact color math for sRGB, Linear sRGB (Houdini/Unreal), HSL, OKLCH, and WCAG 2.1 contrast.
struct ColorMath {
    let r: Double // 0...1 sRGB
    let g: Double // 0...1 sRGB
    let b: Double // 0...1 sRGB

    init(nsColor: NSColor) {
        let converted = nsColor.usingColorSpace(.sRGB) ?? nsColor
        self.r = max(0.0, min(1.0, Double(converted.redComponent)))
        self.g = max(0.0, min(1.0, Double(converted.greenComponent)))
        self.b = max(0.0, min(1.0, Double(converted.blueComponent)))
    }

    init?(hex: String) {
        var cleaned = hex.trimmingCharacters(in: .whitespacesAndNewlines)
        if cleaned.hasPrefix("#") { cleaned.removeFirst() }
        if cleaned.count == 3 {
            cleaned = cleaned.map { "\($0)\($0)" }.joined()
        }
        guard cleaned.count == 6, let val = UInt32(cleaned, radix: 16) else { return nil }
        self.r = Double((val >> 16) & 0xFF) / 255.0
        self.g = Double((val >> 8) & 0xFF) / 255.0
        self.b = Double(val & 0xFF) / 255.0
    }

    var nsColor: NSColor {
        NSColor(srgbRed: CGFloat(r), green: CGFloat(g), blue: CGFloat(b), alpha: 1.0)
    }

    var r255: Int { Int(round(r * 255.0)) }
    var g255: Int { Int(round(g * 255.0)) }
    var b255: Int { Int(round(b * 255.0)) }

    func hexString(lowercase: Bool) -> String {
        let raw = String(format: "#%02X%02X%02X", r255, g255, b255)
        return lowercase ? raw.lowercased() : raw
    }

    var rgbString: String {
        "rgb(\(r255), \(g255), \(b255))"
    }

    // 18 October 2026: IEC 61966-2-1 exact sRGB to Linear transfer for Houdini Copernicus / Karma / Unreal.
    static func toLinear(_ c: Double) -> Double {
        return c <= 0.04045 ? (c / 12.92) : pow((c + 0.055) / 1.055, 2.4)
    }

    var linearRGB: (Double, Double, Double) {
        (Self.toLinear(r), Self.toLinear(g), Self.toLinear(b))
    }

    func linearString(precision: Int) -> String {
        let p = max(2, min(4, precision))
        let (lr, lg, lb) = linearRGB
        let fmt = "%.\(p)f"
        return String(format: "{\(fmt), \(fmt), \(fmt)}", lr, lg, lb)
    }

    var hsl: (h: Int, s: Int, l: Int) {
        let maxC = max(r, g, b)
        let minC = min(r, g, b)
        let l = (maxC + minC) / 2.0
        if maxC == minC {
            return (0, 0, Int(round(l * 100.0)))
        }
        let d = maxC - minC
        let s = l > 0.5 ? d / (2.0 - maxC - minC) : d / (maxC + minC)
        var h: Double = 0
        if maxC == r {
            h = (g - b) / d + (g < b ? 6.0 : 0.0)
        } else if maxC == g {
            h = (b - r) / d + 2.0
        } else {
            h = (r - g) / d + 4.0
        }
        h /= 6.0
        return (Int(round(h * 360.0)) % 360, Int(round(s * 100.0)), Int(round(l * 100.0)))
    }

    var hslString: String {
        let (h, s, l) = hsl
        return "hsl(\(h), \(s)%, \(l)%)"
    }

    // 18 October 2026: Björn Ottosson OKLab / OKLCH conversion from linear sRGB.
    var oklch: (L: Double, C: Double, H: Double) {
        let (lr, lg, lb) = linearRGB
        let l = 0.4122214708 * lr + 0.5363325363 * lg + 0.0514459929 * lb
        let m = 0.2119034982 * lr + 0.6806995451 * lg + 0.1073969566 * lb
        let s = 0.0883024619 * lr + 0.2817188376 * lg + 0.6299787005 * lb
        let l_ = cbrt(l)
        let m_ = cbrt(m)
        let s_ = cbrt(s)
        let L = 0.2104542553 * l_ + 0.7936177850 * m_ - 0.0040720468 * s_
        let a = 1.9779984951 * l_ - 2.4285922050 * m_ + 0.4505937099 * s_
        let bVal = 0.0259040371 * l_ + 0.7827717662 * m_ - 0.8086757660 * s_
        let C = sqrt(a * a + bVal * bVal)
        var H = atan2(bVal, a) * 180.0 / .pi
        if H < 0 { H += 360.0 }
        return (max(0.0, min(1.0, L)), max(0.0, C), C < 0.0001 ? 0.0 : H)
    }

    func oklchString(precision: Int) -> String {
        let p = max(2, min(4, precision))
        let (L, C, H) = oklch
        let fmt = "%.\(p)f"
        return String(format: "oklch(\(fmt) \(fmt) %.1f)", L, C, H)
    }

    var relativeLuminance: Double {
        let (lr, lg, lb) = linearRGB
        return 0.2126 * lr + 0.7152 * lg + 0.0722 * lb
    }

    func contrastRatio(with other: ColorMath) -> Double {
        let l1 = max(self.relativeLuminance, other.relativeLuminance)
        let l2 = min(self.relativeLuminance, other.relativeLuminance)
        return (l1 + 0.05) / (l2 + 0.05)
    }

    var idealTextColor: NSColor {
        relativeLuminance > 0.36 ? NSColor(calibratedWhite: 0.08, alpha: 0.92) : NSColor(calibratedWhite: 0.98, alpha: 0.95)
    }
}

// 18 October 2026: Adaptive rounded card view that updates automatically between light and dark macOS themes.
final class CardView: NSView {
    var fillColor: NSColor = NSColor.controlBackgroundColor { didSet { needsDisplay = true } }
    var strokeColor: NSColor = NSColor.separatorColor { didSet { needsDisplay = true } }
    var radius: CGFloat = 10 { didSet { needsDisplay = true } }
    override func draw(_ dirtyRect: NSRect) {
        let path = NSBezierPath(roundedRect: bounds.insetBy(dx: 0.5, dy: 0.5), xRadius: radius, yRadius: radius)
        fillColor.setFill()
        path.fill()
        strokeColor.setStroke()
        path.lineWidth = 1.0
        path.stroke()
    }
}

// 18 October 2026: Interactive color swatch button supporting left-click (eyedropper/select) and right-click (secondary action).
final class SwatchView: NSView {
    var color: ColorMath = ColorMath(hex: "#b62721")! { didSet { needsDisplay = true } }
    var titleText: String = ""
    var hexText: String = ""
    var sansFont: NSFont = .systemFont(ofSize: 11)
    var monoFont: NSFont = .monospacedSystemFont(ofSize: 12, weight: .regular)
    var radius: CGFloat = 10
    var onLeftClick: (() -> Void)?
    var onRightClick: (() -> Void)?

    override func draw(_ dirtyRect: NSRect) {
        let rect = bounds.insetBy(dx: 0.5, dy: 0.5)
        let path = NSBezierPath(roundedRect: rect, xRadius: radius, yRadius: radius)
        color.nsColor.setFill()
        path.fill()
        NSColor.separatorColor.withAlphaComponent(0.35).setStroke()
        path.lineWidth = 1.0
        path.stroke()

        let textColor = color.idealTextColor
        if !titleText.isEmpty {
            let titleAttrs: [NSAttributedString.Key: Any] = [
                .font: sansFont,
                .foregroundColor: textColor.withAlphaComponent(0.78)
            ]
            NSString(string: titleText).draw(at: NSPoint(x: 10, y: bounds.height - 22), withAttributes: titleAttrs)
        }
        if !hexText.isEmpty {
            let hexAttrs: [NSAttributedString.Key: Any] = [
                .font: monoFont,
                .foregroundColor: textColor
            ]
            NSString(string: hexText).draw(at: NSPoint(x: 10, y: 8), withAttributes: hexAttrs)
        }
    }

    override func mouseDown(with event: NSEvent) {
        if event.modifierFlags.contains(.option) || event.modifierFlags.contains(.control) {
            onRightClick?()
        } else {
            onLeftClick?()
        }
    }

    override func rightMouseDown(with event: NSEvent) {
        onRightClick?()
    }
}

// 18 October 2026: Carbon hotkey callback forwarding global shortcuts to the main app delegate.
private var sharedPickerApp: ZenRayColorPickerApp?

private func carbonHotKeyHandler(nextHandler: EventHandlerCallRef?, event: EventRef?, userData: UnsafeMutableRawPointer?) -> OSStatus {
    guard let event = event else { return OSStatus(eventNotHandledErr) }
    var hotKeyID = EventHotKeyID()
    let status = GetEventParameter(
        event,
        EventParamName(kEventParamDirectObject),
        EventParamType(typeEventHotKeyID),
        nil,
        MemoryLayout<EventHotKeyID>.size,
        nil,
        &hotKeyID
    )
    if status == noErr {
        DispatchQueue.main.async {
            if hotKeyID.id == 1 {
                sharedPickerApp?.pickForegroundGlobal()
            } else if hotKeyID.id == 2 {
                sharedPickerApp?.toggleWindow()
            }
        }
    }
    return noErr
}

final class ZenRayColorPickerApp: NSObject, NSApplicationDelegate, NSWindowDelegate {
    var settings: HDASettings!
    var defaultSettings: HDASettings!
    var state: AppState!
    var statusItem: NSStatusItem!
    var window: NSPanel!
    var rootStack: NSStackView!
    var scrollView: NSScrollView!

    var fontSans: NSFont!
    var fontSerif: NSFont!
    var fontSerifTitle: NSFont!
    var fontMono: NSFont!
    var fontsLoaded: [String: Bool] = [:]

    var showHDAPanel = false
    var copiedBannerText: String?
    var bannerTimer: Timer?
    var hotKeyRefPick: EventHotKeyRef?
    var hotKeyRefToggle: EventHotKeyRef?

    let appSupportDir: URL = {
        let base = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first!
        return base.appendingPathComponent("ZenRayColorPicker", isDirectory: true)
    }()

    var userSettingsURL: URL { appSupportDir.appendingPathComponent("Settings.json") }
    var stateURL: URL { appSupportDir.appendingPathComponent("State.json") }

    func applicationDidFinishLaunching(_ notification: Notification) {
        if ProcessInfo.processInfo.environment["ZENRAY_PICKER_PROOF"] == nil {
            let running = NSRunningApplication.runningApplications(withBundleIdentifier: "com.zenray.colorpicker")
            if running.count > 1 {
                for app in running where app.processIdentifier != ProcessInfo.processInfo.processIdentifier {
                    app.activate(options: [.activateAllWindows])
                }
                NSApp.terminate(nil)
                return
            }
        }
        sharedPickerApp = self
        try? FileManager.default.createDirectory(at: appSupportDir, withIntermediateDirectories: true)

        registerBundledFonts()
        loadSettingsAndState()
        rebuildFonts()
        setupStatusItem()
        setupWindow()
        registerGlobalHotKeys()
        rebuildUI()

        if CommandLine.arguments.contains("--show-hda") {
            showHDAPanel = true
            rebuildUI()
        }

        // 18 October 2026: Open window on launch when opened interactively (unless --background is passed by LaunchAgent).
        if !CommandLine.arguments.contains("--background") || CommandLine.arguments.contains("--show") || ProcessInfo.processInfo.environment["ZENRAY_PICKER_PROOF"] != nil {
            showWindowBelowStatusItem()
        }

        if let proofPath = ProcessInfo.processInfo.environment["ZENRAY_PICKER_PROOF"] {
            let screenshotPath = ProcessInfo.processInfo.environment["ZENRAY_PICKER_SCREENSHOT"]
            DispatchQueue.main.asyncAfter(deadline: .now() + 0.45) {
                self.writeVerificationProof(to: proofPath, screenshotPath: screenshotPath)
            }
        }
    }

    func applicationShouldHandleReopen(_ sender: NSApplication, hasVisibleWindows flag: Bool) -> Bool {
        showWindowBelowStatusItem()
        return true
    }

    func applicationDidBecomeActive(_ notification: Notification) {
        if !window.isVisible {
            showWindowBelowStatusItem()
        }
    }

    // 18 October 2026: Register bundled TTF fonts from Contents/Resources/Fonts so fallback is never silent.
    func registerBundledFonts() {
        let fontsDir = Bundle.main.bundleURL.appendingPathComponent("Contents/Resources/Fonts")
        guard let items = try? FileManager.default.contentsOfDirectory(at: fontsDir, includingPropertiesForKeys: nil) else { return }
        for url in items where url.pathExtension.lowercased() == "ttf" || url.pathExtension.lowercased() == "otf" {
            CTFontManagerRegisterFontsForURL(url as CFURL, .process, nil)
        }
    }

    func loadSettingsAndState() {
        let bundledSettingsURL = Bundle.main.bundleURL.appendingPathComponent("Contents/Resources/Settings.json")
        if let data = try? Data(contentsOf: bundledSettingsURL),
           let decoded = try? JSONDecoder().decode(HDASettings.self, from: data) {
            defaultSettings = decoded
        } else {
            defaultSettings = HDASettings(
                defaultFormat: "HEX",
                autoCopyOnPick: true,
                lowercaseHex: true,
                floatPrecision: 3,
                historyLimit: 20,
                windowWidth: 404,
                fontSize: 13,
                pickOnMenuClick: false,
                alwaysOnTop: true,
                fontSans: "InterVariable",
                fontSerif: "AnthropicSerif-Regular",
                fontMono: "AnthropicMono-Regular",
                initialForegroundHex: "#b62721",
                initialBackgroundHex: "#1f1f1e"
            )
        }

        if let userData = try? Data(contentsOf: userSettingsURL),
           let userDecoded = try? JSONDecoder().decode(HDASettings.self, from: userData) {
            settings = userDecoded
        } else {
            settings = defaultSettings
            saveSettings()
        }

        if let stateData = try? Data(contentsOf: stateURL),
           let decodedState = try? JSONDecoder().decode(AppState.self, from: stateData) {
            state = decodedState
        } else {
            // 18 October 2026: Seed with migrated Pika colors if bundled in Resources/MigratedColors.json.
            let migratedURL = Bundle.main.bundleURL.appendingPathComponent("Contents/Resources/MigratedColors.json")
            var initialHistory: [String] = ["#b62721", "#a78c5c", "#a49a70", "#465637", "#81e1fb", "#ec7972", "#76a2d0", "#99f8d3", "#c5c8cd", "#f19e46"]
            if let mData = try? Data(contentsOf: migratedURL),
               let mColors = try? JSONDecoder().decode([String].self, from: mData), !mColors.isEmpty {
                initialHistory = mColors
            }
            state = AppState(
                foregroundHex: initialHistory.first ?? settings.initialForegroundHex,
                backgroundHex: settings.initialBackgroundHex,
                history: Array(initialHistory.prefix(settings.historyLimit))
            )
            saveState()
        }
    }

    func saveSettings() {
        let encoder = JSONEncoder()
        encoder.outputFormatting = [.prettyPrinted, .sortedKeys]
        if let data = try? encoder.encode(settings) {
            try? data.write(to: userSettingsURL, options: .atomic)
        }
    }

    func saveState() {
        let encoder = JSONEncoder()
        encoder.outputFormatting = [.prettyPrinted]
        if let data = try? encoder.encode(state) {
            try? data.write(to: stateURL, options: .atomic)
        }
    }

    // 18 October 2026: Build the ZenRay typographic trio (InterVariable 400, AnthropicSerif-Regular 400, AnthropicMono-Regular 400).
    func rebuildFonts() {
        let sz = CGFloat(max(11.0, min(16.0, settings.fontSize)))
        let rawSans = NSFont(name: settings.fontSans, size: sz)
        let rawSerif = NSFont(name: settings.fontSerif, size: sz)
        let rawMono = NSFont(name: settings.fontMono, size: sz)

        fontsLoaded = [
            settings.fontSans: rawSans != nil,
            settings.fontSerif: rawSerif != nil,
            settings.fontMono: rawMono != nil
        ]

        fontSans = rawSans ?? NSFont.systemFont(ofSize: sz, weight: .regular)
        fontSerif = rawSerif ?? NSFont.systemFont(ofSize: sz, weight: .regular)
        fontSerifTitle = NSFont(name: settings.fontSerif, size: sz + 2.5) ?? fontSerif
        fontMono = rawMono ?? NSFont.monospacedSystemFont(ofSize: sz, weight: .regular)
    }

    func setupStatusItem() {
        statusItem = NSStatusBar.system.statusItem(withLength: NSStatusItem.variableLength)
        statusItem.autosaveName = "com.zenray.colorpicker.status"
        if let button = statusItem.button {
            if let icon = NSImage(systemSymbolName: "eyedropper.halffull", accessibilityDescription: "ZenRay Color Picker") {
                icon.size = NSSize(width: 15, height: 15)
                icon.isTemplate = true
                button.image = icon
            } else {
                button.title = "Color"
            }
            button.toolTip = "ZenRay Color Picker (Clic: panneau · Clic droit ou ⌘⇧C: pipette directe)"
            button.target = self
            button.action = #selector(statusItemClicked(_:))
            button.sendAction(on: [.leftMouseUp, .rightMouseUp])
        }
    }

    func setupWindow() {
        let w = CGFloat(max(360.0, min(480.0, settings.windowWidth)))
        window = NSPanel(
            contentRect: NSRect(x: 0, y: 0, width: w, height: 460),
            styleMask: [.titled, .closable, .fullSizeContentView, .nonactivatingPanel],
            backing: .buffered,
            defer: false
        )
        window.titleVisibility = .hidden
        window.titlebarAppearsTransparent = true
        window.isFloatingPanel = settings.alwaysOnTop
        window.level = settings.alwaysOnTop ? .floating : .normal
        window.collectionBehavior = [.canJoinAllSpaces, .fullScreenAuxiliary]
        window.isMovableByWindowBackground = true
        window.hasShadow = true
        window.delegate = self

        // 18 October 2026: Liquid Glass / native macOS vibrancy material.
        let visualEffect = NSVisualEffectView(frame: NSRect(x: 0, y: 0, width: w, height: 460))
        visualEffect.material = .popover
        visualEffect.blendingMode = .behindWindow
        visualEffect.state = .active
        visualEffect.autoresizingMask = [.width, .height]

        scrollView = NSScrollView(frame: visualEffect.bounds)
        scrollView.autoresizingMask = [.width, .height]
        scrollView.drawsBackground = false
        scrollView.borderType = .noBorder
        scrollView.hasVerticalScroller = true
        scrollView.verticalScroller?.controlSize = .small

        rootStack = NSStackView()
        rootStack.orientation = .vertical
        rootStack.alignment = .leading
        rootStack.distribution = .fill
        rootStack.spacing = 10
        rootStack.edgeInsets = NSEdgeInsets(top: 28, left: 14, bottom: 14, right: 14)

        scrollView.documentView = rootStack
        visualEffect.addSubview(scrollView)
        window.contentView = visualEffect
    }

    func registerGlobalHotKeys() {
        var eventType = EventTypeSpec(eventClass: OSType(kEventClassKeyboard), eventKind: UInt32(kEventHotKeyPressed))
        InstallEventHandler(GetApplicationEventTarget(), carbonHotKeyHandler, 1, &eventType, nil, nil)

        // 18 October 2026: HotKey 1 = Cmd + Shift + C (keyCode 8 = 'C') -> direct eyedropper
        let hotKeyID1 = EventHotKeyID(signature: OSType(0x5A524350), id: 1) // 'ZRCP'
        RegisterEventHotKey(UInt32(kVK_ANSI_C), UInt32(cmdKey | shiftKey), hotKeyID1, GetApplicationEventTarget(), 0, &hotKeyRefPick)

        // 18 October 2026: HotKey 2 = Option + Cmd + C (keyCode 8 = 'C') -> toggle window
        let hotKeyID2 = EventHotKeyID(signature: OSType(0x5A524350), id: 2)
        RegisterEventHotKey(UInt32(kVK_ANSI_C), UInt32(cmdKey | optionKey), hotKeyID2, GetApplicationEventTarget(), 0, &hotKeyRefToggle)
    }

    @objc func statusItemClicked(_ sender: NSStatusBarButton) {
        guard let event = NSApp.currentEvent else {
            toggleWindow()
            return
        }
        if event.type == .rightMouseUp || event.modifierFlags.contains(.option) || settings.pickOnMenuClick {
            pickColor(isForeground: true)
        } else {
            toggleWindow()
        }
    }

    func toggleWindow() {
        if window.isVisible {
            window.orderOut(nil)
        } else {
            showWindowBelowStatusItem()
        }
    }

    func showWindowBelowStatusItem() {
        let w = CGFloat(max(360.0, min(480.0, settings.windowWidth)))
        let h = window.frame.height
        if let button = statusItem.button, let btnWin = button.window {
            let btnFrame = btnWin.frame
            let x = round(btnFrame.midX - w / 2.0)
            let y = round(btnFrame.minY - h - 6.0)
            window.setFrame(NSRect(x: max(12, x), y: max(40, y), width: w, height: h), display: true)
        } else if let screen = NSScreen.main {
            let vf = screen.visibleFrame
            window.setFrame(NSRect(x: vf.maxX - w - 20, y: vf.maxY - h - 12, width: w, height: h), display: true)
        }
        window.level = settings.alwaysOnTop ? .floating : .normal
        window.makeKeyAndOrderFront(nil)
        NSApp.activate(ignoringOtherApps: true)
    }

    func pickForegroundGlobal() {
        pickColor(isForeground: true)
    }

    // 18 October 2026: Launch Apple's native Retina pixel loupe (NSColorSampler) without blocking the screen.
    func pickColor(isForeground: Bool) {
        let wasVisible = window.isVisible
        if wasVisible {
            window.orderOut(nil)
        }
        DispatchQueue.main.asyncAfter(deadline: .now() + 0.08) { [weak self] in
            let sampler = NSColorSampler()
            sampler.show { [weak self] selectedColor in
                guard let self = self else { return }
                if let picked = selectedColor {
                    let math = ColorMath(nsColor: picked)
                    let hex = math.hexString(lowercase: self.settings.lowercaseHex)
                    if isForeground {
                        self.setForeground(hex: hex, copyIfEnabled: self.settings.autoCopyOnPick)
                    } else {
                        self.state.backgroundHex = hex
                        self.saveState()
                        self.rebuildUI()
                    }
                }
                self.showWindowBelowStatusItem()
            }
        }
    }

    func setForeground(hex: String, copyIfEnabled: Bool) {
        guard let math = ColorMath(hex: hex) else { return }
        let normalized = math.hexString(lowercase: settings.lowercaseHex)
        state.foregroundHex = normalized
        state.history.removeAll { $0.lowercased() == normalized.lowercased() }
        state.history.insert(normalized, at: 0)
        if state.history.count > settings.historyLimit {
            state.history = Array(state.history.prefix(settings.historyLimit))
        }
        saveState()
        if copyIfEnabled {
            let formatted = formattedValue(for: settings.defaultFormat, color: math)
            copyToPasteboard(formatted, label: settings.defaultFormat)
        } else {
            rebuildUI()
        }
    }

    func formattedValue(for format: String, color: ColorMath) -> String {
        switch format.uppercased() {
        case "RGB": return color.rgbString
        case "HSL": return color.hslString
        case "OKLCH": return color.oklchString(precision: settings.floatPrecision)
        case "LINEAR": return color.linearString(precision: settings.floatPrecision)
        default: return color.hexString(lowercase: settings.lowercaseHex)
        }
    }

    func copyToPasteboard(_ value: String, label: String) {
        NSPasteboard.general.clearContents()
        NSPasteboard.general.setString(value, forType: .string)
        copiedBannerText = "Copié (\(label)) : \(value)"
        bannerTimer?.invalidate()
        bannerTimer = Timer.scheduledTimer(withTimeInterval: 2.2, repeats: false) { [weak self] _ in
            self?.copiedBannerText = nil
            self?.rebuildUI()
        }
        rebuildUI()
    }

    // 18 October 2026: Helper to build labels strictly respecting the ZenRay typographic trio.
    func makeLabel(_ text: String, font: NSFont, color: NSColor = .labelColor) -> NSTextField {
        let tf = NSTextField(labelWithString: text)
        tf.font = font
        tf.textColor = color
        tf.lineBreakMode = .byTruncatingTail
        return tf
    }

    func makeIconButton(symbol: String, title: String? = nil, toolTip: String, action: Selector) -> NSButton {
        let btn = NSButton()
        btn.bezelStyle = .recessed
        btn.isBordered = true
        btn.font = fontSans
        btn.toolTip = toolTip
        btn.target = self
        btn.action = action
        btn.setContentCompressionResistancePriority(.required, for: .horizontal)
        btn.setContentHuggingPriority(.required, for: .horizontal)
        if let img = NSImage(systemSymbolName: symbol, accessibilityDescription: toolTip) {
            btn.image = img
            btn.imagePosition = title == nil ? .imageOnly : .imageLeading
        }
        btn.title = title ?? ""
        return btn
    }

