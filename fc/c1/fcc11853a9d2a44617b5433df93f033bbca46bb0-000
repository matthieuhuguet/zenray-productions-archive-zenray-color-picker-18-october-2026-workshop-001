        let encoder = JSONEncoder()
        encoder.outputFormatting = [.prettyPrinted, .sortedKeys]
        if let data = try? encoder.encode(settings), let str = String(data: data, encoding: .utf8) {
            copyToPasteboard(str, formatId: "HDA")
        }
