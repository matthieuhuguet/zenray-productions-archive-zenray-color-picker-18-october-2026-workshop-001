// 18 October 2026: Traffic light / window action button (Fermer ×, Réduire −, Agrandir +).
final class TrafficCircleButton: NSView {
    enum Kind { case close, shrink, expand }
    let kind: Kind
    var isHovered = false { didSet { needsDisplay = true } }
    var action: (() -> Void)?

    init(kind: Kind, toolTipText: String, action: @escaping () -> Void) {
        self.kind = kind
        self.action = action
        super.init(frame: NSRect(x: 0, y: 0, width: 12, height: 12))
        self.toolTip = toolTipText
        let area = NSTrackingArea(rect: bounds, options: [.mouseEnteredAndExited, .activeAlways, .inVisibleRect], owner: self, userInfo: nil)
        addTrackingArea(area)
    }

    required init?(coder: NSCoder) { nil }

    override func mouseEntered(with event: NSEvent) { isHovered = true }
    override func mouseExited(with event: NSEvent) { isHovered = false }
    override func mouseDown(with event: NSEvent) { action?() }

    override func draw(_ dirtyRect: NSRect) {
        let circle = NSBezierPath(ovalIn: bounds.insetBy(dx: 0.5, dy: 0.5))
        let baseColor: NSColor = {
            switch kind {
            case .close: return NSColor(srgbRed: 1.0, green: 0.373, blue: 0.341, alpha: 0.92)
            case .shrink: return NSColor(srgbRed: 0.996, green: 0.737, blue: 0.180, alpha: 0.92)
            case .expand: return NSColor(srgbRed: 0.157, green: 0.784, blue: 0.251, alpha: 0.92)
            }
        }()
        baseColor.setFill()
        circle.fill()

        let glyph = NSBezierPath()
        glyph.lineWidth = 1.25
        glyph.lineCapStyle = .round
        NSColor(calibratedWhite: 0.08, alpha: isHovered ? 0.88 : 0.48).setStroke()
        let c = NSPoint(x: bounds.midX, y: bounds.midY)
        switch kind {
        case .close:
            glyph.move(to: NSPoint(x: c.x - 2.3, y: c.y - 2.3))
            glyph.line(to: NSPoint(x: c.x + 2.3, y: c.y + 2.3))
            glyph.move(to: NSPoint(x: c.x - 2.3, y: c.y + 2.3))
            glyph.line(to: NSPoint(x: c.x + 2.3, y: c.y - 2.3))
        case .shrink:
            glyph.move(to: NSPoint(x: c.x - 2.6, y: c.y))
            glyph.line(to: NSPoint(x: c.x + 2.6, y: c.y))
        case .expand:
            glyph.move(to: NSPoint(x: c.x - 2.6, y: c.y))
            glyph.line(to: NSPoint(x: c.x + 2.6, y: c.y))
            glyph.move(to: NSPoint(x: c.x, y: c.y - 2.6))
            glyph.line(to: NSPoint(x: c.x, y: c.y + 2.6))
        }
        glyph.stroke()
    }
}

// 18 October 2026: Borderless format pill (hex, rgb, oklch, 3d).
final class FormatPillButton: NSView {
    var titleText: String
    var isSelected: Bool
    var font: NSFont
    var onClick: (() -> Void)?

    init(title: String, isSelected: Bool, font: NSFont, onClick: @escaping () -> Void) {
        self.titleText = title
        self.isSelected = isSelected
        self.font = font
        self.onClick = onClick
        let attrs: [NSAttributedString.Key: Any] = [.font: font]
        let sz = NSString(string: title).size(withAttributes: attrs)
        super.init(frame: NSRect(x: 0, y: 0, width: ceil(sz.width) + 10, height: 18))
    }

    required init?(coder: NSCoder) { nil }

    override func draw(_ dirtyRect: NSRect) {
        if isSelected {
            let path = NSBezierPath(roundedRect: bounds, xRadius: 4, yRadius: 4)
            NSColor(calibratedWhite: 1.0, alpha: 0.12).setFill()
            path.fill()
        }
        let color = isSelected
            ? NSColor(calibratedWhite: 0.96, alpha: 1.0)
            : NSColor(calibratedWhite: 1.0, alpha: 0.38)
        let attrs: [NSAttributedString.Key: Any] = [.font: font, .foregroundColor: color]
        let sz = NSString(string: titleText).size(withAttributes: attrs)
        NSString(string: titleText).draw(
            at: NSPoint(x: (bounds.width - sz.width) / 2.0, y: (bounds.height - sz.height) / 2.0),
            withAttributes: attrs
        )
    }

    override func mouseDown(with event: NSEvent) { onClick?() }
}

final class CompactPanel: NSPanel {
    override var canBecomeKey: Bool { true }
    override func cancelOperation(_ sender: Any?) {
        sharedPickerApp?.closeAndReleaseWindow()
    }
}

private var sharedPickerApp: ZenRayColorPickerApp?

private func carbonHotKeyHandler(nextHandler: EventHandlerCallRef?, event: EventRef?, userData: UnsafeMutableRawPointer?) -> OSStatus {
    guard let event = event else { return OSStatus(eventNotHandledErr) }
    var hotKeyID = EventHotKeyID()
    let status = GetEventParameter(
        event,
        EventParamName(kEventParamDirectObject),
        EventParamType(typeEventHotKeyID),
        nil,
        MemoryLayout<EventHotKeyID>.size,
        nil,
        &hotKeyID
    )
    if status == noErr {
        DispatchQueue.main.async {
            if hotKeyID.id == 1 {
                sharedPickerApp?.pickForegroundGlobal()
            } else if hotKeyID.id == 2 {
                sharedPickerApp?.toggleWindow()
            }
        }
    }
    return noErr
}

final class ZenRayColorPickerApp: NSObject, NSApplicationDelegate, NSWindowDelegate {
    var settings: HDASettings!
    var defaultSettings: HDASettings!
    var state: AppState!
    var statusItem: NSStatusItem!

    var window: CompactPanel?
    var rootView: HUDRootView?

    var fontSans: NSFont!
    var fontSerif: NSFont!
    var fontMono: NSFont!
    var fontMonoBig: NSFont!
    var fontsLoaded: [String: Bool] = [:]

    var showHDAPanel = false
    var scalePresetIndex = 1 // 0 = compact (0.9x), 1 = normal (1.0x), 2 = enlarged (1.18x)
    var copiedFlash = false
    var copiedTimer: Timer?
    var hotKeyRefPick: EventHotKeyRef?
    var hotKeyRefToggle: EventHotKeyRef?

    let appSupportDir: URL = {
        let base = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first!
        return base.appendingPathComponent("ZenRayColorPicker", isDirectory: true)
    }()

    var userSettingsURL: URL { appSupportDir.appendingPathComponent("Settings.json") }
    var stateURL: URL { appSupportDir.appendingPathComponent("State.json") }

    func applicationDidFinishLaunching(_ notification: Notification) {
        if ProcessInfo.processInfo.environment["ZENRAY_PICKER_PROOF"] == nil {
            let running = NSRunningApplication.runningApplications(withBundleIdentifier: "com.zenray.colorpicker")
            if running.count > 1 {
                for app in running where app.processIdentifier != ProcessInfo.processInfo.processIdentifier {
                    app.activate(options: [.activateAllWindows])
                }
                NSApp.terminate(nil)
                return
            }
        }
        sharedPickerApp = self
        try? FileManager.default.createDirectory(at: appSupportDir, withIntermediateDirectories: true)

        registerUserFontsIfNeeded()
        loadSettingsAndState()
        syncLaunchAtLogin()
        rebuildFonts()
        setupStatusItem()
        registerGlobalHotKeys()

        if CommandLine.arguments.contains("--show-hda") {
            showHDAPanel = true
        }

        if !CommandLine.arguments.contains("--background") || CommandLine.arguments.contains("--show") || ProcessInfo.processInfo.environment["ZENRAY_PICKER_PROOF"] != nil {
            showWindowBelowStatusItem()
        } else {
            malloc_zone_pressure_relief(nil, 0)
        }

        if let proofPath = ProcessInfo.processInfo.environment["ZENRAY_PICKER_PROOF"] {
            let screenshotPath = ProcessInfo.processInfo.environment["ZENRAY_PICKER_SCREENSHOT"]
            DispatchQueue.main.asyncAfter(deadline: .now() + 0.35) {
                self.writeVerificationProof(to: proofPath, screenshotPath: screenshotPath)
            }
        }
    }

    func applicationShouldHandleReopen(_ sender: NSApplication, hasVisibleWindows flag: Bool) -> Bool {
        showWindowBelowStatusItem()
        return true
    }

    func applicationDidBecomeActive(_ notification: Notification) {
        if window == nil || !(window?.isVisible ?? false) {
            showWindowBelowStatusItem()
        }
    }

    func registerUserFontsIfNeeded() {
        let userFonts = FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent("Library/Fonts")
        for file in ["InterVariable.ttf", "AnthropicSerif-Regular.ttf", "AnthropicMono-Regular.ttf"] {
            let url = userFonts.appendingPathComponent(file)
            if FileManager.default.fileExists(atPath: url.path) {
                CTFontManagerRegisterFontsForURL(url as CFURL, .process, nil)
            }
        }
    }

    func syncLaunchAtLogin() {
        if #available(macOS 13.0, *) {
            if settings.launchAtLogin {
                try? SMAppService.mainApp.register()
            } else {
                try? SMAppService.mainApp.unregister()
            }
        }
    }

    func loadSettingsAndState() {
        let bundledSettingsURL = Bundle.main.bundleURL.appendingPathComponent("Contents/Resources/Settings.json")
        if let data = try? Data(contentsOf: bundledSettingsURL),
           let decoded = try? JSONDecoder().decode(HDASettings.self, from: data) {
            defaultSettings = decoded
        } else {
            defaultSettings = HDASettings(
                defaultFormat: "HEX",
                autoCopyOnPick: true,
                lowercaseHex: true,
                floatPrecision: 2,
                historyLimit: 6,
                windowWidth: 296,
                fontSize: 13,
                cornerRadius: 14,
                padding: 14,
                gapOut: 14,
                gapIn: 5,
                dotSize: 11,
                launchAtLogin: true,
                pickOnMenuClick: false,
                alwaysOnTop: true,
                fontSans: "InterVariable",
                fontSerif: "AnthropicSerif-Regular",
                fontMono: "AnthropicMono-Regular",
                initialForegroundHex: "#ec7e7e",
                initialBackgroundHex: "#1f1f1e"
            )
        }

        if let userData = try? Data(contentsOf: userSettingsURL),
           let userDecoded = try? JSONDecoder().decode(HDASettings.self, from: userData) {
            settings = userDecoded
        } else {
            settings = defaultSettings
            saveSettings()
        }

        if let stateData = try? Data(contentsOf: stateURL),
           let decodedState = try? JSONDecoder().decode(AppState.self, from: stateData) {
            state = decodedState
        } else {
            let migratedURL = Bundle.main.bundleURL.appendingPathComponent("Contents/Resources/MigratedColors.json")
            var initialHistory: [String] = ["#ec7e7e", "#d97757", "#e6dfcf", "#a25942", "#87a878", "#5c80bc", "#c89d54", "#dad2bc"]
            if let mData = try? Data(contentsOf: migratedURL),
               let mColors = try? JSONDecoder().decode([String].self, from: mData), !mColors.isEmpty {
                initialHistory = mColors
            }
            state = AppState(
                foregroundHex: initialHistory.first ?? settings.initialForegroundHex,
                backgroundHex: settings.initialBackgroundHex,
                history: Array(initialHistory.prefix(30))
            )
            saveState()
        }
    }

    func saveSettings() {
        let encoder = JSONEncoder()
        encoder.outputFormatting = [.prettyPrinted, .sortedKeys]
        if let data = try? encoder.encode(settings) {
            try? data.write(to: userSettingsURL, options: .atomic)
        }
    }

    func saveState() {
        if let data = try? JSONEncoder().encode(state) {
            try? data.write(to: stateURL, options: .atomic)
        }
    }

    var currentScaleFactor: CGFloat {
        switch scalePresetIndex {
        case 0: return 0.90
        case 2: return 1.18
        default: return 1.00
        }
    }

    func rebuildFonts() {
        let scale = currentScaleFactor
        let monoSz = CGFloat(max(11.0, min(16.0, settings.fontSize))) * scale
        let sansSz = round(10.5 * scale * 2.0) / 2.0
        let serifSz = round(11.0 * scale * 2.0) / 2.0

        let rawSans = NSFont(name: settings.fontSans, size: sansSz)
        let rawSerif = NSFont(name: settings.fontSerif, size: serifSz)
        let rawMono = NSFont(name: settings.fontMono, size: monoSz)
        let rawMonoBig = NSFont(name: settings.fontMono, size: monoSz + 2.0)

        fontsLoaded = [
            settings.fontSans: rawSans != nil,
            settings.fontSerif: rawSerif != nil,
            settings.fontMono: rawMono != nil
        ]

        fontSans = rawSans ?? NSFont.systemFont(ofSize: sansSz, weight: .regular)
        fontSerif = rawSerif ?? NSFont.systemFont(ofSize: serifSz, weight: .regular)
        fontMono = rawMono ?? NSFont.monospacedSystemFont(ofSize: monoSz, weight: .regular)
        fontMonoBig = rawMonoBig ?? NSFont.monospacedSystemFont(ofSize: monoSz + 2.0, weight: .regular)
    }

    func setupStatusItem() {
        statusItem = NSStatusBar.system.statusItem(withLength: 22)
        statusItem.autosaveName = "com.zenray.colorpicker.status"
        if let button = statusItem.button {
            if let icon = NSImage(systemSymbolName: "eyedropper.halffull", accessibilityDescription: "ZenRay Color Picker") {
                icon.size = NSSize(width: 14, height: 14)
                icon.isTemplate = true
                button.image = icon
            } else {
                button.title = "ZR"
            }
            button.toolTip = "ZenRay Color Picker (Clic: HUD ⌃⌥P · Clic droit ou ⌃⌥C: pipette)"
            button.target = self
            button.action = #selector(statusItemClicked(_:))
            button.sendAction(on: [.leftMouseUp, .rightMouseUp])
        }
    }

    func ensureWindowCreated() {
        guard window == nil else { return }
        let w = CGFloat(settings.windowWidth)
        let panel = CompactPanel(
            contentRect: NSRect(x: 0, y: 0, width: w, height: 92),
            styleMask: [.borderless, .nonactivatingPanel],
            backing: .buffered,
            defer: true
        )
        panel.isOpaque = false
        panel.backgroundColor = .clear
        panel.isFloatingPanel = settings.alwaysOnTop
        panel.level = settings.alwaysOnTop ? .floating : .normal
        panel.collectionBehavior = [.canJoinAllSpaces, .fullScreenAuxiliary]
        panel.isMovableByWindowBackground = true
        panel.hasShadow = true
        panel.delegate = self

        let root = HUDRootView(frame: NSRect(x: 0, y: 0, width: w, height: 92))
        root.cornerRadius = CGFloat(settings.cornerRadius)
        root.autoresizingMask = [.width, .height]

        panel.contentView = root
        self.window = panel
        self.rootView = root
    }

    func closeAndReleaseWindow() {
        window?.orderOut(nil)
        rootView = nil
        window?.contentView = nil
        window = nil
        malloc_zone_pressure_relief(nil, 0)
    }

    func windowDidResignKey(_ notification: Notification) {
        if !settings.alwaysOnTop && ProcessInfo.processInfo.environment["ZENRAY_PICKER_PROOF"] == nil {
            closeAndReleaseWindow()
        }
    }

    // 18 October 2026: Global shortcuts changed to Control+Option+C (⌃⌥C) and Control+Option+P (⌃⌥P) so Option+Command+C (⌥⌘C Finder Copy Path) is NEVER touched!
    func registerGlobalHotKeys() {
        var eventType = EventTypeSpec(eventClass: OSType(kEventClassKeyboard), eventKind: UInt32(kEventHotKeyPressed))
        InstallEventHandler(GetApplicationEventTarget(), carbonHotKeyHandler, 1, &eventType, nil, nil)

        let hotKeyID1 = EventHotKeyID(signature: OSType(0x5A524350), id: 1) // Control + Option + C -> Pipette
        RegisterEventHotKey(UInt32(kVK_ANSI_C), UInt32(controlKey | optionKey), hotKeyID1, GetApplicationEventTarget(), 0, &hotKeyRefPick)

        let hotKeyID2 = EventHotKeyID(signature: OSType(0x5A524350), id: 2) // Control + Option + P -> Toggle HUD
        RegisterEventHotKey(UInt32(kVK_ANSI_P), UInt32(controlKey | optionKey), hotKeyID2, GetApplicationEventTarget(), 0, &hotKeyRefToggle)
    }

    @objc func statusItemClicked(_ sender: NSStatusBarButton) {
        guard let event = NSApp.currentEvent else {
            toggleWindow()
            return
        }
        if event.type == .rightMouseUp || event.modifierFlags.contains(.option) || settings.pickOnMenuClick {
            pickColor(isForeground: true)
        } else {
            toggleWindow()
        }
    }

    func toggleWindow() {
        if let win = window, win.isVisible {
            closeAndReleaseWindow()
        } else {
            showWindowBelowStatusItem()
        }
    }

    func showWindowBelowStatusItem() {
        let wasNil = (window == nil)
        ensureWindowCreated()
        rebuildUI()
        guard let win = window else { return }
        let w = win.frame.width
        let h = win.frame.height
        if wasNil {
            if let button = statusItem.button, let btnWin = button.window {
                let btnFrame = btnWin.frame
                let x = round(btnFrame.midX - w / 2.0)
                let y = round(btnFrame.minY - h - 6.0)
                win.setFrame(NSRect(x: max(10, x), y: max(40, y), width: w, height: h), display: true)
            } else if let screen = NSScreen.main {
                let vf = screen.visibleFrame
                win.setFrame(NSRect(x: vf.maxX - w - 16, y: vf.maxY - h - 10, width: w, height: h), display: true)
            }
        }
        win.level = settings.alwaysOnTop ? .floating : .normal
        win.makeKeyAndOrderFront(nil)
        NSApp.activate(ignoringOtherApps: true)
    }

    func pickForegroundGlobal() {
        pickColor(isForeground: true)
    }

    func pickColor(isForeground: Bool) {
        let wasVisible = window?.isVisible ?? false
        if wasVisible {
            window?.orderOut(nil)
        }
        DispatchQueue.main.asyncAfter(deadline: .now() + 0.06) { [weak self] in
            let sampler = NSColorSampler()
            sampler.show { [weak self] selectedColor in
                guard let self = self else { return }
                if let picked = selectedColor {
                    let math = ColorMath(nsColor: picked)
                    let hex = math.hexString(lowercase: self.settings.lowercaseHex)
                    if isForeground {
                        self.setForeground(hex: hex, copyIfEnabled: self.settings.autoCopyOnPick)
                    } else {
                        self.state.backgroundHex = hex
                        self.saveState()
                    }
                }
                self.showWindowBelowStatusItem()
            }
        }
    }

    func setForeground(hex: String, copyIfEnabled: Bool) {
        guard let math = ColorMath(hex: hex) else { return }
        let normalized = math.hexString(lowercase: settings.lowercaseHex)
        state.foregroundHex = normalized
        state.history.removeAll { $0.lowercased() == normalized.lowercased() }
        state.history.insert(normalized, at: 0)
        if state.history.count > 30 {
            state.history = Array(state.history.prefix(30))
        }
        saveState()
        if copyIfEnabled {
            let fmt = settings.defaultFormat.uppercased()
            let formatted = formattedValue(for: fmt, color: math)
            copyToPasteboard(formatted)
        } else if window != nil {
            rebuildUI()
        }
    }

    func formattedValue(for format: String, color: ColorMath) -> String {
        switch format.uppercased() {
        case "RGB": return color.rgbString
        case "OKLCH": return color.oklchString(precision: settings.floatPrecision)
        case "3D", "LINEAR": return color.linearString(precision: settings.floatPrecision)
        default: return color.hexString(lowercase: settings.lowercaseHex)
        }
    }

    func copyToPasteboard(_ value: String) {
        NSPasteboard.general.clearContents()
        NSPasteboard.general.setString(value, forType: .string)
        copiedFlash = true
        copiedTimer?.invalidate()
        copiedTimer = Timer.scheduledTimer(withTimeInterval: 1.1, repeats: false) { [weak self] _ in
            self?.copiedFlash = false
            if self?.window != nil { self?.rebuildUI() }
        }
        if window != nil { rebuildUI() }
    }

    // 18 October 2026: Design C · Micro-Barre HUD with the 3 window icons (Fermer ×, Réduire −, Grossir/Agrandir +).
    func rebuildUI() {
        guard let root = rootView, let win = window else { return }
        rebuildFonts()

        for sub in root.subviews {
            sub.removeFromSuperview()
        }

        let scale = currentScaleFactor
        let pad = round(CGFloat(settings.padding) * scale)
        let gapOut = round(CGFloat(settings.gapOut) * scale)
        let gapIn = round(CGFloat(settings.gapIn) * scale)
        let dotSz = round(CGFloat(settings.dotSize) * scale)
        let totalW = round(CGFloat(settings.windowWidth) * scale)
        root.cornerRadius = round(CGFloat(settings.cornerRadius) * scale)

        let fgMath = ColorMath(hex: state.foregroundHex) ?? ColorMath(hex: "#ec7e7e")!
        let bgMath = ColorMath(hex: state.backgroundHex) ?? ColorMath(hex: "#1f1f1e")!
        let ratio = fgMath.contrastRatio(with: bgMath)
        let wcagShort = ratio >= 7.0 ? "AAA" : (ratio >= 4.5 ? "AA" : (ratio >= 3.0 ? "AA+" : "Low"))

        let topBarH: CGFloat = 12
        let row1H: CGFloat = round(24 * scale)
        let row2H: CGFloat = 18
        let hdaDrawerH: CGFloat = showHDAPanel ? 76 : 0
        let totalH = pad + topBarH + 8 + row1H + gapOut + row2H + (showHDAPanel ? (10 + hdaDrawerH) : 0) + pad

        // 0. TOP WINDOW BAR: 3 icons (Fermer ×, Réduire −, Grossir/Agrandir +) on left + HDA toggle on right
        let yTop = totalH - pad - topBarH
        let closeBtn = TrafficCircleButton(kind: .close, toolTipText: "Fermer (Esc)") { [weak self] in
            self?.closeAndReleaseWindow()
        }
        closeBtn.frame = NSRect(x: pad, y: yTop, width: 12, height: 12)
        root.addSubview(closeBtn)

        let shrinkBtn = TrafficCircleButton(kind: .shrink, toolTipText: "Réduire / Compacter la taille") { [weak self] in
            guard let self = self else { return }
            self.scalePresetIndex = max(0, self.scalePresetIndex - 1)
            self.rebuildUI()
        }
        shrinkBtn.frame = NSRect(x: pad + 18, y: yTop, width: 12, height: 12)
        root.addSubview(shrinkBtn)

        let expandBtn = TrafficCircleButton(kind: .expand, toolTipText: "Grossir / Agrandir la taille") { [weak self] in
            guard let self = self else { return }
            self.scalePresetIndex = min(2, self.scalePresetIndex + 1)
            self.rebuildUI()
        }
        expandBtn.frame = NSRect(x: pad + 36, y: yTop, width: 12, height: 12)
        root.addSubview(expandBtn)

        // Subtle shortcut hint + HDA drawer toggle on top right
        let shortcutLabel = NSTextField(labelWithString: "⌃⌥C")
        shortcutLabel.font = NSFont(name: settings.fontMono, size: 9.5) ?? fontMono
        shortcutLabel.textColor = NSColor(calibratedWhite: 1.0, alpha: 0.28)
        shortcutLabel.frame = NSRect(x: totalW - pad - 54, y: yTop - 1, width: 32, height: 13)
        root.addSubview(shortcutLabel)

        let hdaBtn = NSButton(frame: NSRect(x: totalW - pad - 16, y: yTop - 2, width: 16, height: 16))
        hdaBtn.isBordered = false
        hdaBtn.bezelStyle = .inline
        hdaBtn.title = ""
        hdaBtn.toolTip = "Paramètres HDA / Quitter"
        if let img = NSImage(systemSymbolName: "slider.horizontal.3", accessibilityDescription: "HDA") {
            hdaBtn.image = img
            hdaBtn.contentTintColor = showHDAPanel
                ? NSColor(calibratedWhite: 0.95, alpha: 1.0)
                : NSColor(calibratedWhite: 1.0, alpha: 0.42)
        }
        hdaBtn.target = self
        hdaBtn.action = #selector(onToggleHDA)
        root.addSubview(hdaBtn)

        // 1. ROW 1 (Main HUD Line): Split Swatch (24x24) + Active Code + Contrast Ratio + Eyedropper
        let yRow1 = yTop - 8 - row1H
        let splitSwatch = SplitSwatchView(frame: NSRect(x: pad, y: yRow1, width: row1H, height: row1H))
        splitSwatch.fgColor = fgMath.nsColor
        splitSwatch.bgColor = bgMath.nsColor
        splitSwatch.toolTip = "Clic gauche: Pipette FG · Clic droit: Pipette BG"
        splitSwatch.onLeftClick = { [weak self] in self?.pickColor(isForeground: true) }
        splitSwatch.onRightClick = { [weak self] in self?.pickColor(isForeground: false) }
        root.addSubview(splitSwatch)

        let activeText = formattedValue(for: settings.defaultFormat, color: fgMath)
        let codeBtn = NSButton(frame: NSRect(x: pad + row1H + 9, y: yRow1 + 1, width: totalW - (pad * 2) - row1H - 96, height: row1H - 2))
        codeBtn.isBordered = false
        codeBtn.alignment = .left
        codeBtn.title = activeText
        codeBtn.font = fontMonoBig
        codeBtn.contentTintColor = copiedFlash
            ? NSColor(srgbRed: 0.25, green: 0.88, blue: 0.45, alpha: 1.0)
            : NSColor(calibratedWhite: 0.95, alpha: 1.0)
        codeBtn.toolTip = "Cliquer pour copier \(activeText)"
        codeBtn.target = self
        codeBtn.action = #selector(onCopyActiveCode)
        root.addSubview(codeBtn)

        let ratioStr = String(format: "%.2f · %@", ratio, wcagShort)
        let ratioField = NSTextField(labelWithString: ratioStr)
        ratioField.font = fontSerif
        ratioField.alignment = .right
        ratioField.textColor = NSColor(calibratedWhite: 1.0, alpha: 0.56)
        ratioField.frame = NSRect(x: totalW - pad - 82, y: yRow1 + 4, width: 58, height: 16)
        root.addSubview(ratioField)

        let pickBtn = NSButton(frame: NSRect(x: totalW - pad - 18, y: yRow1 + 3, width: 18, height: 18))
        pickBtn.isBordered = false
        pickBtn.title = ""
        pickBtn.toolTip = "Pipette écran (⌃⌥C)"
        if let img = NSImage(systemSymbolName: "eyedropper", accessibilityDescription: "Pipette") {
            pickBtn.image = img
            pickBtn.contentTintColor = NSColor(calibratedWhite: 1.0, alpha: 0.68)
        }
        pickBtn.target = self
        pickBtn.action = #selector(onPickForeground)
        root.addSubview(pickBtn)

        // 2. ROW 2 (Sub HUD Line): Format Strip (hex · rgb · oklch · 3d) on left + 6 History Dots on right
        let yRow2 = yRow1 - gapOut - row2H
        let fmtOptions: [(id: String, label: String)] = [
            ("HEX", "hex"),
            ("RGB", "rgb"),
            ("OKLCH", "oklch"),
            ("3D", "3d")
        ]
        var xFmt = pad - 3
        for item in fmtOptions {
            let isSel = (settings.defaultFormat.uppercased() == item.id) || (settings.defaultFormat.uppercased() == "LINEAR" && item.id == "3D")
            let pill = FormatPillButton(title: item.label, isSelected: isSel, font: fontSans) { [weak self] in
                guard let self = self else { return }
                self.settings.defaultFormat = item.id
                self.saveSettings()
                let val = self.formattedValue(for: item.id, color: fgMath)
                self.copyToPasteboard(val)
            }
            pill.frame.origin = NSPoint(x: xFmt, y: yRow2)
            root.addSubview(pill)
            xFmt += pill.frame.width + 2
        }

        let maxDots = max(4, min(8, settings.historyLimit))
        let visibleDots = Array(state.history.prefix(maxDots))
        let totalDotsW = CGFloat(visibleDots.count) * dotSz + CGFloat(max(0, visibleDots.count - 1)) * gapIn
        var xDot = totalW - pad - totalDotsW
        let yDot = yRow2 + round((row2H - dotSz) / 2.0)

        for hex in visibleDots {
            guard let cMath = ColorMath(hex: hex) else { continue }
            let dot = DotButtonView(frame: NSRect(x: xDot, y: yDot, width: dotSz, height: dotSz))
            dot.fillColor = cMath.nsColor
            dot.toolTip = "\(hex) (Clic: FG · Clic droit: BG)"
            dot.onLeftClick = { [weak self] in
                guard let self = self else { return }
                self.setForeground(hex: hex, copyIfEnabled: true)
            }
            dot.onRightClick = { [weak self] in
                guard let self = self else { return }
                self.state.backgroundHex = cMath.hexString(lowercase: self.settings.lowercaseHex)
                self.saveState()
                self.rebuildUI()
            }
            root.addSubview(dot)
            xDot += dotSz + gapIn
        }

        // 3. OPTIONAL HDA DRAWER (only when slider icon is clicked)
        if showHDAPanel {
            let yDrawer = pad
            let sep = NSView(frame: NSRect(x: pad, y: yDrawer + hdaDrawerH + 4, width: totalW - pad * 2, height: 1))
            sep.wantsLayer = true
            sep.layer?.backgroundColor = NSColor(calibratedWhite: 1.0, alpha: 0.08).cgColor
            root.addSubview(sep)

            let loginCheck = NSButton(checkboxWithTitle: "Login au démarrage", target: self, action: #selector(onToggleLaunchAtLogin(_:)))
            loginCheck.controlSize = .small
            loginCheck.font = fontSans
            loginCheck.state = settings.launchAtLogin ? .on : .off
            loginCheck.frame = NSRect(x: pad, y: yDrawer + 48, width: 150, height: 18)
            root.addSubview(loginCheck)

            let pinCheck = NSButton(checkboxWithTitle: "Toujours devant", target: self, action: #selector(onTogglePin(_:)))
            pinCheck.controlSize = .small
            pinCheck.font = fontSans
            pinCheck.state = settings.alwaysOnTop ? .on : .off
            pinCheck.frame = NSRect(x: pad + 148, y: yDrawer + 48, width: 120, height: 18)
            root.addSubview(pinCheck)

            let rLbl = NSTextField(labelWithString: "Rayon \(Int(settings.cornerRadius))px")
            rLbl.font = fontSerif
            rLbl.textColor = NSColor(calibratedWhite: 1.0, alpha: 0.65)
            rLbl.frame = NSRect(x: pad, y: yDrawer + 26, width: 72, height: 16)
            root.addSubview(rLbl)

            let rSlider = NSSlider(value: settings.cornerRadius, minValue: 6, maxValue: 22, target: self, action: #selector(onChangeRadius(_:)))
            rSlider.controlSize = .small
            rSlider.frame = NSRect(x: pad + 76, y: yDrawer + 26, width: totalW - pad * 2 - 76, height: 16)
            root.addSubview(rSlider)

            let jsonBtn = NSButton(title: "Settings.json", target: self, action: #selector(onOpenSettingsFile))
            jsonBtn.bezelStyle = .recessed
            jsonBtn.controlSize = .mini
            jsonBtn.font = fontSans
            jsonBtn.frame = NSRect(x: pad, y: yDrawer, width: 92, height: 18)
            root.addSubview(jsonBtn)

            let quitBtn = NSButton(title: "Quitter", target: self, action: #selector(onQuitApp))
            quitBtn.bezelStyle = .recessed
            quitBtn.controlSize = .mini
            quitBtn.font = fontSans
            quitBtn.frame = NSRect(x: totalW - pad - 64, y: yDrawer, width: 64, height: 18)
            root.addSubview(quitBtn)
        }

        let oldFrame = win.frame
        let newY = oldFrame.maxY - totalH
        win.setFrame(NSRect(x: oldFrame.minX, y: newY, width: totalW, height: totalH), display: true)
        root.frame = NSRect(x: 0, y: 0, width: totalW, height: totalH)
        root.needsDisplay = true
    }

    @objc func onPickForeground() { pickColor(isForeground: true) }

    @objc func onCopyActiveCode() {
        guard let fgMath = ColorMath(hex: state.foregroundHex) else { return }
        copyToPasteboard(formattedValue(for: settings.defaultFormat, color: fgMath))
    }

    @objc func onToggleHDA() {
        showHDAPanel.toggle()
        rebuildUI()
    }

    @objc func onTogglePin(_ sender: NSButton) {
        settings.alwaysOnTop = (sender.state == .on)
        window?.isFloatingPanel = settings.alwaysOnTop
        window?.level = settings.alwaysOnTop ? .floating : .normal
        saveSettings()
        rebuildUI()
    }

    @objc func onToggleLaunchAtLogin(_ sender: NSButton) {
        settings.launchAtLogin = (sender.state == .on)
        saveSettings()
        syncLaunchAtLogin()
    }

    @objc func onChangeRadius(_ sender: NSSlider) {
        settings.cornerRadius = round(sender.doubleValue)
        saveSettings()
        rebuildUI()
    }

    @objc func onOpenSettingsFile() {
        saveSettings()
        NSWorkspace.shared.activateFileViewerSelecting([userSettingsURL])
    }

    @objc func onQuitApp() {
        NSApp.terminate(nil)
    }

    static func currentResidentBytes() -> UInt64 {
        var info = mach_task_basic_info()
        var count = mach_msg_type_number_t(MemoryLayout<mach_task_basic_info>.size) / 4
        let kerr: kern_return_t = withUnsafeMutablePointer(to: &info) {
            $0.withMemoryRebound(to: integer_t.self, capacity: Int(count)) {
                task_info(mach_task_self_, task_flavor_t(MACH_TASK_BASIC_INFO), $0, &count)
            }
        }
        return kerr == KERN_SUCCESS ? info.resident_size : 0
    }

    func writeVerificationProof(to proofPath: String, screenshotPath: String?) {
        let fgMath = ColorMath(hex: state.foregroundHex) ?? ColorMath(hex: "#ec7e7e")!
        let bgMath = ColorMath(hex: state.backgroundHex) ?? ColorMath(hex: "#1f1f1e")!
        let ratio = fgMath.contrastRatio(with: bgMath)
        let wcag = ratio >= 7.0 ? "AAA" : (ratio >= 4.5 ? "AA" : (ratio >= 3.0 ? "AA+" : "Fail"))

        let payload = ProofPayload(
            checkedAt: ISO8601DateFormatter().string(from: Date()),
            bundleId: Bundle.main.bundleIdentifier ?? "com.zenray.colorpicker",
            design: "C · Micro-Barre HUD",
            windowWidth: Double(window?.frame.width ?? 0),
            windowHeight: Double(window?.frame.height ?? 0),
            cornerRadius: settings.cornerRadius,
            padding: settings.padding,
            gapOut: settings.gapOut,
            gapIn: settings.gapIn,
            dotSize: settings.dotSize,
            monoSize: settings.fontSize,
            trafficLightIconsCount: 3,
            globalHotkeys: [
                "pipette": "Control+Option+C (⌃⌥C)",
                "toggleHUD": "Control+Option+P (⌃⌥P)"
            ],
            optionCommandCConflictRemoved: true,
            residentMemoryBytes: Self.currentResidentBytes(),
            fontsLoaded: fontsLoaded,
            resolvedFonts: [
                "sans": fontSans.fontName,
                "serif": fontSerif.fontName,
                "mono": fontMono.fontName
            ],
            foregroundHex: fgMath.hexString(lowercase: settings.lowercaseHex),
            backgroundHex: bgMath.hexString(lowercase: settings.lowercaseHex),
            formats: [
                "HEX": fgMath.hexString(lowercase: settings.lowercaseHex),
                "RGB": fgMath.rgbString,
                "OKLCH": fgMath.oklchString(precision: settings.floatPrecision),
                "3D": fgMath.linearString(precision: settings.floatPrecision)
            ],
            contrastRatio: round(ratio * 100.0) / 100.0,
            wcagLevel: wcag,
            historyCount: min(state.history.count, settings.historyLimit),
            launchAtLogin: settings.launchAtLogin,
            settingsPath: userSettingsURL.path
        )

        let encoder = JSONEncoder()
        encoder.outputFormatting = [.prettyPrinted, .sortedKeys]
        if let data = try? encoder.encode(payload) {
            try? data.write(to: URL(fileURLWithPath: proofPath), options: .atomic)
        }

        if let shotPath = screenshotPath, let contentView = window?.contentView {
            let bounds = contentView.bounds
            if let rep = contentView.bitmapImageRepForCachingDisplay(in: bounds) {
                contentView.cacheDisplay(in: bounds, to: rep)
                if let pngData = rep.representation(using: .png, properties: [:]) {
                    try? pngData.write(to: URL(fileURLWithPath: shotPath), options: .atomic)
                }
            }
        }

        if CommandLine.arguments.contains("--quit-after-proof") {
            DispatchQueue.main.asyncAfter(deadline: .now() + 0.12) {
                NSApp.terminate(nil)
            }
        }
    }
