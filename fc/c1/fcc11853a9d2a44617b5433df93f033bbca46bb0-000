    // MARK: - UI Actions

    @objc func onPickForeground() { pickColor(isForeground: true) }

    @objc func onTogglePin() {
        settings.alwaysOnTop.toggle()
        window.isFloatingPanel = settings.alwaysOnTop
        window.level = settings.alwaysOnTop ? .floating : .normal
        saveSettings()
        rebuildUI()
    }

    @objc func onToggleHDA() {
        showHDAPanel.toggle()
        rebuildUI()
    }

    @objc func onSwapColors() {
        let tmp = state.foregroundHex
        state.foregroundHex = state.backgroundHex
        state.backgroundHex = tmp
        saveState()
        rebuildUI()
    }

    @objc func onCopyFormatRow(_ sender: NSButton) {
        let formatId = sender.identifier?.rawValue ?? "HEX"
        guard let fgMath = ColorMath(hex: state.foregroundHex) else { return }
        let val = formattedValue(for: formatId, color: fgMath)
        copyToPasteboard(val, label: formatId)
    }

    @objc func onChangeDefaultFormat(_ sender: NSPopUpButton) {
        if let title = sender.selectedItem?.title {
            settings.defaultFormat = title
            saveSettings()
            rebuildUI()
        }
    }

    @objc func onToggleAutoCopy(_ sender: NSButton) {
        settings.autoCopyOnPick = (sender.state == .on)
        saveSettings()
        rebuildUI()
    }

    @objc func onToggleLowercaseHex(_ sender: NSButton) {
        settings.lowercaseHex = (sender.state == .on)
        saveSettings()
        rebuildUI()
    }

    @objc func onChangePrecision(_ sender: NSSegmentedControl) {
        settings.floatPrecision = sender.selectedSegment + 2
        saveSettings()
        rebuildUI()
    }

    @objc func onTogglePickOnClick(_ sender: NSButton) {
        settings.pickOnMenuClick = (sender.state == .on)
        saveSettings()
        rebuildUI()
    }

    @objc func onChangeHistoryLimit(_ sender: NSSlider) {
        settings.historyLimit = Int(round(sender.doubleValue))
        saveSettings()
        rebuildUI()
    }

    @objc func onChangeWindowWidth(_ sender: NSSlider) {
        settings.windowWidth = round(sender.doubleValue)
        saveSettings()
        rebuildUI()
    }

    @objc func onChangeFontSize(_ sender: NSSlider) {
        settings.fontSize = round(sender.doubleValue)
        saveSettings()
        rebuildUI()
    }

    @objc func onCopyHDAJson() {
        let encoder = JSONEncoder()
        encoder.outputFormatting = [.prettyPrinted, .sortedKeys]
        if let data = try? encoder.encode(settings), let str = String(data: data, encoding: .utf8) {
            copyToPasteboard(str, label: "HDA JSON")
        }
    }

    @objc func onOpenSettingsFile() {
        saveSettings()
        NSWorkspace.shared.activateFileViewerSelecting([userSettingsURL])
    }

    @objc func onResetHDA() {
        settings = defaultSettings
        saveSettings()
        rebuildUI()
    }

    @objc func onQuitApp() {
        NSApp.terminate(nil)
    }

    // 18 October 2026: Write measured runtime proof and optional window capture PNG.
    func writeVerificationProof(to proofPath: String, screenshotPath: String?) {
        let fgMath = ColorMath(hex: state.foregroundHex) ?? ColorMath(hex: "#b62721")!
        let bgMath = ColorMath(hex: state.backgroundHex) ?? ColorMath(hex: "#1f1f1e")!
        let ratio = fgMath.contrastRatio(with: bgMath)
        let wcag = ratio >= 7.0 ? "AAA" : (ratio >= 4.5 ? "AA" : (ratio >= 3.0 ? "AA Large" : "Fail"))

        let payload = ProofPayload(
            checkedAt: ISO8601DateFormatter().string(from: Date()),
            bundleId: Bundle.main.bundleIdentifier ?? "com.zenray.colorpicker",
            windowWidth: Double(window.frame.width),
            windowHeight: Double(window.frame.height),
            fontsLoaded: fontsLoaded,
            resolvedFonts: [
                "sans": fontSans.fontName,
                "serif": fontSerif.fontName,
                "mono": fontMono.fontName
            ],
            foregroundHex: fgMath.hexString(lowercase: settings.lowercaseHex),
            backgroundHex: bgMath.hexString(lowercase: settings.lowercaseHex),
            formats: [
                "HEX": fgMath.hexString(lowercase: settings.lowercaseHex),
                "RGB": fgMath.rgbString,
                "HSL": fgMath.hslString,
                "OKLCH": fgMath.oklchString(precision: settings.floatPrecision),
                "LINEAR": fgMath.linearString(precision: settings.floatPrecision)
            ],
            contrastRatio: round(ratio * 100.0) / 100.0,
            wcagLevel: wcag,
            historyCount: state.history.count,
            hdaParameterCount: 8,
            settingsPath: userSettingsURL.path
        )

        let encoder = JSONEncoder()
        encoder.outputFormatting = [.prettyPrinted, .sortedKeys]
        if let data = try? encoder.encode(payload) {
            try? data.write(to: URL(fileURLWithPath: proofPath), options: .atomic)
        }

        if let shotPath = screenshotPath, let contentView = window.contentView {
            let bounds = contentView.bounds
            if let rep = contentView.bitmapImageRepForCachingDisplay(in: bounds) {
                contentView.cacheDisplay(in: bounds, to: rep)
                if let pngData = rep.representation(using: .png, properties: [:]) {
                    try? pngData.write(to: URL(fileURLWithPath: shotPath), options: .atomic)
                }
            }
        }

        if CommandLine.arguments.contains("--quit-after-proof") {
            DispatchQueue.main.asyncAfter(deadline: .now() + 0.15) {
                NSApp.terminate(nil)
            }
        }
    }
}

let app = NSApplication.shared
let delegate = ZenRayColorPickerApp()
app.delegate = delegate
app.setActivationPolicy(.accessory)
app.run()
